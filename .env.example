# Google Cloud OAuth 2.0 Web application
GOOGLE_CLIENT_ID="dummy-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="dummy-client-secret"

# NextAuth URL and a sufficiently long random production secret
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Exact Workspace hosted domain and comma-separated operator allowlist
ALLOWED_DOMAIN="example.ac.jp"
ALLOWED_OPERATOR_EMAILS="operator1@example.ac.jp,operator2@example.ac.jp"
